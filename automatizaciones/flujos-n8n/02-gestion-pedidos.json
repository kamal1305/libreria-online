{
  "name": "Segunda Vuelta Libros - Gestion de Pedidos (Lineal)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pedido-recibido",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "18804cd3-f4a6-4966-b0a7-e9c21fed822d",
      "name": "Webhook Pedido",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1200, 100],
      "webhookId": "pedido-recibido"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\n\nconst orderId = String(body.order_id || body.id || 'PED-' + Date.now());\nconst customerName = body.customer_name || 'Cliente';\nconst customerEmail = body.customer_email || body.email || '';\nconst platform = body.platform || 'Web';\nconst shippingAddress = body.shipping_address || '';\nconst paymentStatus = body.payment_status || 'paid';\nconst total = Number(body.total || 0);\nconst items = body.items || [];\n\nif (!items || items.length === 0) {\n  throw new Error('Pedido sin articulos');\n}\n\nconst firstItem = items[0] || {};\nconst itemsSummary = items.map(i => (i.title || 'Libro') + ' (' + (i.sku || 'sin sku') + ') - ' + (i.price || 0) + ' eur').join('; ');\nconst fecha = new Date().toISOString().split('T')[0];\n\nreturn [{\n  json: {\n    orderId: orderId,\n    customerName: customerName,\n    customerEmail: customerEmail,\n    platform: platform,\n    shippingAddress: shippingAddress,\n    paymentStatus: paymentStatus,\n    total: total,\n    itemsSummary: itemsSummary,\n    fecha: fecha,\n    sku: String(firstItem.sku || '').trim(),\n    title: firstItem.title || '',\n    price: Number(firstItem.price || 0)\n  }\n}];"
      },
      "id": "85070d75-dc79-4e0d-9636-ef4d2224f72f",
      "name": "Procesar Pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-980, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/databases/3e358b98-802d-8034-8058-f75a48890b65/query",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer NOTION_API_KEY"
            },
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filter\": {\n    \"property\": \"SKU\",\n    \"rich_text\": {\n      \"equals\": \"{{ $json.sku }}\"\n    }\n  }\n}",
        "options": {}
      },
      "id": "39a128c5-f91a-4492-85ab-4f6c9429f847",
      "name": "Buscar Libro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-760, 100]
    },
    {
      "parameters": {
        "jsCode": "const orderInfo = $('Procesar Pedido').first().json;\nconst bookResults = $json.results || [];\n\nlet pageId = null;\nlet estado = '';\nlet action = 'incidencia';\n\nif (bookResults.length > 0) {\n  const book = bookResults[0];\n  pageId = book.id;\n  estado = book.properties?.['Estado publicación']?.select?.name || '';\n  \n  if (estado.toLowerCase() === 'publicado') {\n    action = 'reservar';\n  }\n}\n\nreturn [{\n  json: {\n    ...orderInfo,\n    pageId: pageId,\n    estadoLibro: estado,\n    action: action\n  }\n}];"
      },
      "id": "c41cdc4d-3b2d-4601-98da-3fd1d16abeda",
      "name": "Verificar Disponibilidad",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-540, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.action }}",
              "rightValue": "reservar",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "filterRenames": []
        },
        "options": {}
      },
      "id": "3ea79b8b-03e4-468c-98bc-564998ae18af",
      "name": "Reservar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [-320, 100]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.notion.com/v1/pages/{{ $json.pageId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer NOTION_API_KEY"
            },
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"properties\": {\n    \"Estado publicación\": {\n      \"select\": {\n        \"name\": \"Reservado\"\n      }\n    }\n  }\n}",
        "options": {}
      },
      "id": "d1f6ee4a-2be8-4ded-90ba-6335fa5a3493",
      "name": "Marcar Reservado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-100, -20]
    },
    {
      "parameters": {
        "jsCode": "const orderInfo = $('Procesar Pedido').first().json;\n\nlet reserved = false;\ntry {\n  reserved = $('Marcar Reservado').all().length > 0;\n} catch (e) {\n  reserved = false;\n}\n\nreturn [{\n  json: {\n    ...orderInfo,\n    hasIncidence: !reserved,\n    orderStatus: reserved ? 'Pagado' : 'Incidencia',\n    reservedCount: reserved ? 1 : 0,\n    failedCount: reserved ? 0 : 1,\n    notas: reserved ? 'Pedido procesado automáticamente' : 'INCIDENCIA: Libro no disponible'\n  }\n}];"
      },
      "id": "30fe6328-bf95-47f7-9eb8-969cb1eddbac",
      "name": "Finalizar Pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [140, 100]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "databaseId": "3e658b98-802d-80fe-b360-f0a979af8118",
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Nº Pedido|title",
              "title": "={{ $json.orderId }}"
            },
            {
              "key": "Cliente|rich_text",
              "textContent": "={{ $json.customerName }}"
            },
            {
              "key": "Email|email",
              "emailValue": "={{ $json.customerEmail }}"
            },
            {
              "key": "Fecha|date",
              "date": "={{ $json.fecha }}"
            },
            {
              "key": "Estado pedido|select",
              "selectValue": "={{ $json.orderStatus }}"
            },
            {
              "key": "Importe total|number",
              "numberValue": "={{ $json.total }}"
            },
            {
              "key": "Plataforma|select",
              "selectValue": "={{ $json.platform }}"
            },
            {
              "key": "Dirección envío|rich_text",
              "textContent": "={{ $json.shippingAddress }}"
            },
            {
              "key": "Artículos|rich_text",
              "textContent": "={{ $json.itemsSummary }}"
            },
            {
              "key": "Notas|rich_text",
              "textContent": "={{ $json.notas }}"
            }
          ]
        },
        "options": {}
      },
      "id": "1c912677-9038-42b8-9676-8d386db30d3c",
      "name": "Crear Registro",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2,
      "position": [360, 100],
      "credentials": {
        "notionApi": {
          "id": "ya4EhgfQgS1iqHlg",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "masquelibrosjerez@gmail.com",
        "toEmail": "masquelibrosjerez@gmail.com",
        "subject": "=Nuevo pedido #{{ $json.orderId }} - Más que libros",
        "html": "=<h2>📚 ¡Nuevo pedido recibido!</h2>\n<p><strong>Nº Pedido:</strong> #{{ $json.orderId }}</p>\n<p><strong>Cliente:</strong> {{ $json.customerName }} ({{ $json.customerEmail }})</p>\n<p><strong>Plataforma:</strong> {{ $json.platform }}</p>\n<p><strong>Importe total:</strong> {{ $json.total }} €</p>\n<hr/>\n<h3>📖 Libros:</h3>\n<p>{{ $json.itemsSummary }}</p>\n<hr/>\n<p><strong>Dirección de entrega:</strong><br/>{{ $json.shippingAddress }}</p>\n<p><strong>Estado:</strong> {{ $json.hasIncidence ? '⚠️ INCIDENCIA (Revisar stock)' : '✅ OK - Stock reservado y pedido registrado' }}</p>",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [580, 100],
      "id": "2d1bcb56-dc73-458b-9a46-c301b98a00c6",
      "name": "Send an Email",
      "credentials": {
        "smtp": {
          "id": "VPsMIhC7VgFb5Eg3",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: !$json.hasIncidence, order_id: $json.orderId, status: $json.hasIncidence ? 'incidencia' : 'procesado', reserved: $json.reservedCount, incidences: $json.failedCount, message: $json.hasIncidence ? 'Pedido con incidencias de stock' : 'Pedido procesado correctamente' }) }}",
        "options": {}
      },
      "id": "488cb70f-5554-4a1b-8f10-2fe680b6b8a3",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [800, 100]
    }
  ],
  "connections": {
